__id__ = "digital_rain"
__name__ = "Digital Rain"
__description__ = "Movie style digital rain behind every chat and the main header: mirrored katakana, digits and symbols falling in columns at different speeds, a bright white leading glyph with a soft glow, trails that fade to dark, and glyphs that flicker inside the trails. Pick any color by hex or slider, rotate through colors, and set the rain speed, color rotation speed and particle count. Made by [firestarter1996](https://github.com/firestarter1996)."
__author__ = "firestarter1996"
__version__ = "1.2.0"
__min_version__ = "12.5.1"

# Performance first: all drawing lives in a small embedded Java view (no Python per frame).
# It runs on vsync only while its chat is on screen and the screen is on, draws every vsync from a
# clock driven by the vsync timestamps (heads glide by sub pixel steps, so motion is smooth at 60,
# 90 and 120 Hz), skips vsyncs only while the app is missing frames, allocates nothing per frame
# and draws glyphs from two atlases built once.
# 1.2.0 (11-10-2026, owner: the motion looked choppy, advancing in steps): 1.1.1 redrew at most 24
# times a second (16 in the header) and the bright head jumped a whole cell (about 50 px) when it
# entered a new row, so the rain moved in visible steps. Now the head and its glow glide on every
# vsync, the newest trail cell comes out from under the head, the tail fades all the way to nothing,
# and the in place glyph flicker runs at the same rate whatever the refresh rate.
# Python only runs when a chat opens and when a setting changes.
# 1.1.1 (11-08-2026, XF force closed while a chat was drawing right after start): the hook on the
# holiday snow's onDraw was installed from the plugin loading thread while the UI thread was drawing
# snow every frame, and a frame that met the hook half installed died in XposedBridge (its original
# method was still null). Every hook is now installed on the UI thread, between frames.
# Logcat tag: DigitalRain.

import base64
import zlib

from java import jclass, dynamic_proxy, jarray, jfloat
from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class, get_private_field
from client_utils import get_last_fragment
from android_utils import R
from ui.settings import Header, Switch, Divider, Input, Custom, Text

ENTRY = "com.firestarter.digitalrain.RainCore"
DEFAULT_HEX = "#00FF41"


def _log(msg):
    try:
        jclass("android.util.Log").d("DigitalRain", str(msg))
    except Exception:
        pass


def _jint(v):
    v = int(v) & 0xFFFFFFFF
    return v - 0x100000000 if v >= 0x80000000 else v


def _parse_hex(s):
    s = str(s or "").strip().lstrip("#")
    if len(s) == 3:
        s = "".join(ch * 2 for ch in s)
    if len(s) != 6:
        return None
    try:
        return int(s, 16)
    except ValueError:
        return None


class DigitalRainPlugin(BasePlugin):

    def on_plugin_load(self):
        self.alive = True
        self.core = None
        self.rows = {}
        self.refs = []
        self.headers = set()
        self.install_run = None
        # the embedded core (decompress and dex load) stays on the loading thread, off the UI thread
        try:
            self._load_core()
            self._sync()
        except Exception as e:
            self.core = None
            _log("load: %s" % e)
            return
        Looper = jclass("android.os.Looper")
        if Looper.myLooper() == Looper.getMainLooper():
            self._install()
        else:
            self.install_run = R(self._install)
            jclass("org.telegram.messenger.AndroidUtilities").runOnUIThread(self.install_run)
        _log("loaded %s" % __version__)

    def _install(self):
        try:
            if self.alive:
                self._load()
        except Exception as e:
            _log("install: %s" % e)

    def _load(self):
        """Hooks only, on the UI thread (the core is already loaded)."""
        ca_cls = find_class("org.telegram.ui.ChatActivity")
        ctx_cls = find_class("android.content.Context")
        plugin = self

        class CreateViewHook(MethodHook):
            def after_hooked_method(self, param):
                plugin._attach(param.thisObject)

        self.hook_method(ca_cls.getDeclaredMethod("createView", ctx_cls), CreateViewHook())

        # 1.1.0: the main screen header gets the rain too, behind its title and icons
        da_cls = find_class("org.telegram.ui.DialogsActivity")

        class DialogsHook(MethodHook):
            def after_hooked_method(self, param):
                plugin._attach_header(param.thisObject)

        try:
            self.hook_method(da_cls.getDeclaredMethod("createView", ctx_cls), DialogsHook())
        except Exception as e:
            _log("hook: %s" % e)
        # the chat list lives inside the main tabs screen and is built before plugins load,
        # so the tabs screen's resume attaches it too
        class TabsHook(MethodHook):
            def after_hooked_method(self, param):
                try:
                    plugin._attach_header(param.thisObject.getDialogsActivity())
                except Exception as e:
                    _log("tabs: %s" % e)

        try:
            tabs_cls = find_class("org.telegram.ui.MainTabsActivity")
            self.hook_method(tabs_cls.getDeclaredMethod("onResume"), TabsHook())
        except Exception as e:
            _log("hook: %s" % e)
        self.headers = set()

        # Holiday snow (Custom Snow forces it on) draws over every header child; where the rain is,
        # the rain wins. Skipping it also ends snow's own redraw every frame in that header.
        snow_cls = find_class("org.telegram.ui.Components.SnowflakesEffect")
        view_cls = find_class("android.view.View")
        canvas_cls = find_class("android.graphics.Canvas")

        class SnowHook(MethodHook):
            def before_hooked_method(self, param):
                try:
                    if plugin.headers and int(param.args[0].hashCode()) in plugin.headers:
                        param.setResult(None)
                except Exception:
                    pass

        try:
            self.hook_method(snow_cls.getDeclaredMethod("onDraw", view_cls, canvas_cls), SnowHook())
        except Exception as e:
            _log("hook: %s" % e)
        self._attach_all_headers()
        # a chat already open when the plugin loads gets the rain right away
        try:
            f = get_last_fragment()
            if f is not None and ca_cls.isInstance(f):
                self._attach(f)
        except Exception:
            pass

    def on_plugin_unload(self):
        self.alive = False
        try:
            if self.install_run is not None:
                jclass("org.telegram.messenger.AndroidUtilities").cancelRunOnUIThread(self.install_run)
        except Exception:
            pass
        try:
            if self.core is not None:
                self._call("detachAll")
        except Exception as e:
            _log("unload: %s" % e)

    # ---- core --------------------------------------------------------------------

    def _load_core(self):
        ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
        with open(__file__, "r", encoding="utf-8") as fh:
            text = fh.read()
        block = text.rsplit("# __DEX_BEGIN__", 1)[1].split("# __DEX_END__", 1)[0]
        payload = "".join(l.strip()[1:].strip() for l in block.splitlines() if l.strip().startswith("#"))
        data = zlib.decompress(base64.b64decode(payload))
        ByteBuffer = jclass("java.nio.ByteBuffer")
        Loader = jclass("dalvik.system.InMemoryDexClassLoader")
        self.loader = Loader(ByteBuffer.wrap(data), ctx.getClassLoader())
        self.core = self.loader.loadClass(ENTRY)
        self.methods = {}
        for m in self.core.getDeclaredMethods():
            self.methods[str(m.getName())] = m

    def _call(self, name, *args):
        return self.methods[name].invoke(None, *args)

    def _attach(self, chat):
        if not bool(self.get_setting("enabled", True)) or self.core is None:
            return
        try:
            content = get_private_field(chat, "contentView")
            if content is not None:
                self._call("attach", content)
        except Exception as e:
            _log("attach: %s" % e)

    def _attach_header(self, dialogs):
        if not bool(self.get_setting("enabled", True)) or self.core is None:
            return
        try:
            if dialogs is None:
                return
            bar = dialogs.getActionBar()
            if bar is not None and int(bar.hashCode()) not in self.headers:
                self._call("attachHeader", bar)
                self.headers.add(int(bar.hashCode()))
                _log("header %s %dx%d" % (bar.getClass().getSimpleName(), bar.getWidth(), bar.getHeight()))
        except Exception as e:
            _log("header: %s" % e)

    def _attach_all_headers(self):
        try:
            f = get_last_fragment()
            stack = f.getParentLayout().getFragmentStack() if f is not None else None
            da_cls = find_class("org.telegram.ui.DialogsActivity")
            if stack is not None:
                for i in range(stack.size()):
                    fr = stack.get(i)
                    if da_cls.isInstance(fr):
                        self._attach_header(fr)
                    elif str(fr.getClass().getSimpleName()) == "MainTabsActivity":
                        self._attach_header(fr.getDialogsActivity())
        except Exception as e:
            _log("headers: %s" % e)

    def _reset(self, *_):
        for k, v in (("color", DEFAULT_HEX), ("rotate", False), ("rot_speed", "20"),
                     ("rain_speed", "1.0"), ("count", "80"), ("enabled", True)):
            self.set_setting(k, v)
        self._sync()
        for key, row in list(self.rows.items()):
            try:
                row[1]()
            except Exception:
                pass
        try:
            self.reload_settings()
        except Exception as e:
            _log("reset reload: %s" % e)

    def _color(self):
        c = _parse_hex(self.get_setting("color", DEFAULT_HEX))
        return 0x00FF41 if c is None else c

    def _num(self, key, default):
        try:
            return float(self.get_setting(key, default))
        except Exception:
            return float(default)

    def _sync(self, *_):
        if self.core is None:
            return
        Integer = jclass("java.lang.Integer")
        Boolean = jclass("java.lang.Boolean")
        Float = jclass("java.lang.Float")
        try:
            self._call("setConfig",
                       Integer(_jint(0xFF000000 | self._color())),
                       Boolean(bool(self.get_setting("rotate", False))),
                       Float(self._num("rot_speed", 20)),
                       Float(self._num("rain_speed", 1.0)),
                       Integer(int(self._num("count", 80))))
        except Exception as e:
            _log("sync: %s" % e)

    def _on_enabled(self, value):
        if self.core is None:
            return
        if value:
            self._attach_all_headers()
            try:
                f = get_last_fragment()
                if f is not None and find_class("org.telegram.ui.ChatActivity").isInstance(f):
                    self._attach(f)
            except Exception:
                pass
        else:
            self._call("detachAll")
            self.headers = set()

    def _on_hex(self, value):
        c = _parse_hex(value)
        if c is not None:
            self.set_setting("color", "#%06X" % c)
            r = self.rows.get("hue")
            if r is not None:
                r[1]()
        self._sync()

    # ---- settings ------------------------------------------------------------------

    def _slider(self, ctx, key, title, default, lo, hi, fmt, on_value=None, get_value=None, swatch=False):
        LinearLayout = jclass("android.widget.LinearLayout")
        TextView = jclass("android.widget.TextView")
        Gravity = jclass("android.view.Gravity")
        AU = jclass("org.telegram.messenger.AndroidUtilities")
        Theme = jclass("org.telegram.ui.ActionBar.Theme")
        SeekBarView = jclass("org.telegram.ui.Components.SeekBarView")
        LayoutHelper = jclass("org.telegram.ui.Components.LayoutHelper")
        plugin = self
        get = get_value or (lambda: self._num(key, default))

        root = LinearLayout(ctx)
        root.setOrientation(LinearLayout.VERTICAL)
        root.setPadding(AU.dp(21), AU.dp(10), AU.dp(21), AU.dp(12))
        row = LinearLayout(ctx)
        row.setOrientation(LinearLayout.HORIZONTAL)
        row.setGravity(Gravity.CENTER_VERTICAL)
        t = TextView(ctx)
        t.setText(title)
        t.setTextSize(16)
        t.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
        row.addView(t, LinearLayout.LayoutParams(0, -2, 1.0))
        v = TextView(ctx)
        v.setTextSize(14)
        v.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
        v.setTypeface(AU.bold())
        v.setText(fmt(get()))
        sw = None
        if swatch:
            # live preview of the chosen color: a round swatch, and the hex in that color
            GD = jclass("android.graphics.drawable.GradientDrawable")
            sw = GD()
            sw.setShape(GD.OVAL)
            sw.setStroke(AU.dp(1), _jint(0x55FFFFFF))
            dot = jclass("android.view.View")(ctx)
            dot.setBackground(sw)
            row.addView(dot, LayoutHelper.createLinear(22, 22, 0, 0, 10, 0))

        def paint_swatch():
            if sw is not None:
                c = _jint(0xFF000000 | plugin._color())
                sw.setColor(c)
                v.setTextColor(c)

        row.addView(v, LayoutHelper.createLinear(-2, -2))
        root.addView(row, LayoutHelper.createLinear(-1, -2))
        bar = SeekBarView(ctx)
        bar.setReportChanges(True)
        root.addView(bar, LayoutHelper.createLinear(-1, 38, 0, 2, 0, 0, 0))
        dcls = jclass("org.telegram.ui.Components.SeekBarView$SeekBarViewDelegate")

        class D(dynamic_proxy(dcls)):
            def onSeekBarDrag(this, stop, progress):
                val = lo + (hi - lo) * float(progress)
                if on_value is not None:
                    on_value(val)
                else:
                    plugin.set_setting(key, ("%.1f" % val) if hi - lo < 20 else str(int(round(val))))
                v.setText(fmt(val))
                paint_swatch()
                plugin._sync()

            def onSeekBarPressed(this, pressed):
                return None

            def getContentDescription(this):
                return title

            def getStepsCount(this):
                return 0

            def needVisuallyDivideSteps(this):
                return False

        d = D()
        self.refs.append(d)
        bar.setDelegate(d)

        def refresh():
            cur = get()
            v.setText(fmt(cur))
            paint_swatch()
            bar.setProgress(float((cur - lo) / (hi - lo)))

        refresh()
        self.rows[key] = (root, refresh)
        return root

    def _hue(self):
        Color = jclass("android.graphics.Color")
        hsv = jarray(jfloat)([0.0, 0.0, 0.0])
        Color.colorToHSV(_jint(0xFF000000 | self._color()), hsv)
        return float(hsv[0])

    def _set_hue(self, h):
        Color = jclass("android.graphics.Color")
        c = int(Color.HSVToColor(jarray(jfloat)([float(h), 1.0, 1.0]))) & 0xFFFFFF
        self.set_setting("color", "#%06X" % c)

    def create_settings(self):
        items = [
            Switch(key="enabled", text="Digital Rain", default=True, on_change=self._on_enabled,
                   subtext="Movie style rain behind every chat and the main header"),
            Header(text="Color"),
            Input(key="color", text="Color hex", default=DEFAULT_HEX, on_change=self._on_hex,
                  subtext="Film green is #00FF41"),
        ]
        ctx = None
        try:
            f = get_last_fragment()
            ctx = f.getParentActivity() if f is not None else None
        except Exception:
            pass
        UItem = jclass("org.telegram.ui.Components.UItem")

        def custom(key, view):
            return Custom(item=UItem.asCustom(_jint(zlib.crc32(key.encode()) & 0x7FFFFFFF), view))

        if ctx is not None:
            try:
                self.rows = {}
                items.append(custom("hue", self._slider(
                    ctx, "hue", "Color slider", 135, 0.0, 360.0,
                    lambda h: str(self.get_setting("color", DEFAULT_HEX)).upper(),
                    on_value=self._set_hue, get_value=self._hue, swatch=True)))
            except Exception as e:
                _log("hue row: %s" % e)
        items.append(Switch(key="rotate", text="Rotate through colors", default=False, on_change=self._sync))
        if ctx is not None:
            try:
                items.append(custom("rot_speed", self._slider(ctx, "rot_speed", "Color rotation speed", 20, 1.0, 120.0,
                                                              lambda x: "%d° a second" % int(round(x)))))
                items.append(Header(text="Rain"))
                items.append(custom("rain_speed", self._slider(ctx, "rain_speed", "Rain speed", 1.0, 0.2, 3.0,
                                                               lambda x: "%.1fx" % x)))
                items.append(custom("count", self._slider(ctx, "count", "Particle count", 80, 10.0, 300.0,
                                                          lambda x: "%d streams" % int(round(x)))))
            except Exception as e:
                _log("rows: %s" % e)
        items.append(Divider())
        items.append(Text(text="Reset to default", icon="msg_reset", accent=True, on_click=self._reset))
        items.append(Divider(text="Draws only while a chat is on screen, in step with the display, and stops when the screen is off."))
        return items


